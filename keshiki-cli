#!/bin/bash
# Realizado por: S.Konqi0139
#
# Eres libre de modificarlo a tu gusto, solo te pido
# nombrarme como autor del script
#
# La configuración de usuario se lee de una ruta variable y aporta
# variables como systemtray.

HERE="$(dirname "$(readlink -f "${0}")")"
# Las variables systemtray y DIRCONFIG proceden del entorno o de la configuración.
export HERE
export DIRCONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/keshiki/"
export CONFIG="${DIRCONFIG}keshiki.cfg" script=${0##*/}

# shellcheck source=keshiki-session
source "$HERE/keshiki-session"
keshiki_runtime || exit 1
list_wall="$KESHIKI_RUNTIME/list-wall"

case "${1:-}" in
    --pause | --toggle-gui | --close-gui | --close-tray)
        action=$1
        action_status=0
        keshiki_lock || exit 1
        case "$action" in
            --pause) if keshiki_read_session; then keshiki_send '{"command":["cycle","pause"]}' || :; fi ;;
            --toggle-gui)
                if keshiki_component_matches gui keshiki.bash; then
                    keshiki_stop_component gui keshiki.bash || action_status=1
                else
                    (
                        exec {KESHIKI_LOCK}>&-
                        exec "$HERE/keshiki.bash"
                    ) </dev/null >/dev/null 2>&1 &
                fi
                ;;
            --close-gui) keshiki_stop_component gui keshiki.bash || action_status=1 ;;
            --close-tray) keshiki_stop_component tray keshiki-systray || action_status=1 ;;
        esac
        keshiki_unlock
        exit "$action_status"
        ;;
esac

systemtray=FALSE
if [ -f "${CONFIG}" ]; then
    # shellcheck disable=SC1090
    source "${CONFIG}"
fi

BRed='\e[1;31m' BGreen='\e[1;32m' BYellow='\e[1;33m'
BPurple='\e[1;35m' BCyan='\e[1;36m' CReset="\e[m"

if [[ $LANG = es* ]]; then
    Lan=(
        "Uso: $script [OPCIONES]"
        "muestra este texto de ayuda y sale"
        "muestra la versión y sale"
        "inicia el último wallpaper seleccionado."
        "finaliza la reproducción del wallpaper"
        "lista los wallpapers disponibles"
        "<número>  Seleccione un wallpaper que quiera iniciar"
        "nota: solo funciona si antes ejecutó el script con la opción '-l'"
        "<archivo> añade videos (.mp4|.gif|.mkv|.webm|.mov|.avi), imágenes (.gif), o carpetas (folder/)"
        "$script: no se especificó ninguna opción."
        "Pruebe '$script -h' para más información."
    )
else
    Lan=(
        "Use: $script [OPTIONS]"
        "display this help text and exit"
        "show the version and exit"
        "Start the last selected wallpaper."
        "finish wallpaper playback"
        "List the available wallpapers."
        "<number>  Select a wallpaper you want to start."
        "Note: This only works if I run the script with the '-l' option beforehand."
        "<file>    Add videos (.mp4|.gif|.mkv|.webm|.mov|.avi), images (.gif), or folders (folder/)"
        "$script: no option was specified"
        "Try '$script -h' for more information."
    )
fi

print_help() {
    echo -e "\t${Lan[0]}\n
Opciones:
\t-h\t     ${Lan[1]}
\t-v\t     ${Lan[2]}
\t-r\t     ${Lan[3]}
\t-f\t     ${Lan[4]}
\t-l\t     ${Lan[5]}
\t-s ${Lan[6]}
\t\t     ${Lan[7]}
\t-a ${Lan[8]}\n"
}

restore() {
    [ "$systemtray" = "TRUE" ] && "${HERE}/keshiki-systray" &
    "${HERE}/keshiki-start"
}

# Recupera la ruta original de una entrada .desktop generada por keshiki-add.
# SC1003: el patrón \\ compara deliberadamente una sola barra invertida.
# shellcheck disable=SC1003
desktop_string_unescape() {
    local input="$1" output="" char next i
    for ((i = 0; i < ${#input}; i++)); do
        char=${input:i:1}
        if [[ $char == \\ ]] && ((i + 1 < ${#input})); then
            ((i += 1))
            next=${input:i:1}
            case "$next" in
                \\) output+='\' ;;
                n) output+=$'\n' ;;
                t) output+=$'\t' ;;
                r) output+=$'\r' ;;
                *) output+="\\$next" ;;
            esac
        else
            output+="$char"
        fi
    done
    DESKTOP_VALUE=$output
}

parse_exec_path() {
    local value="$1"
    if [[ $value == *"'"* ]]; then
        # Formato antiguo: Exec=/ruta/keshiki-start '/ruta/video'
        value=${value%\'}
        exec_path=${value##*\'}
    else
        # Formato actual: Exec="/ruta/keshiki-start" "/ruta/video"
        value=${value%\"}
        exec_path=${value##*\"}
    fi
}

list_wallpaper() {
    if [[ $LANG = es* ]]; then
        Lang=("listando wallpapers..." "Disponible" "No disponible")
    else
        Lang=("listing wallpapers..." "Available" "Not available")
    fi

    echo -e "${Lang[0]}\n"
    local x=1

    rm -f "$list_wall"
    cd "${DIRCONFIG}" 2>/dev/null || exit
    : >"$list_wall"

    for desk in desktops/*.desktop; do
        [ -e "$desk" ] || continue
        local name="" exec_path="" source_path=""
        while IFS='=' read -r key value; do
            if [[ "$key" == "Name" ]]; then
                name="$value"
            elif [[ "$key" == "X-Keshiki-Source" ]]; then
                desktop_string_unescape "$value"
                source_path=$DESKTOP_VALUE
            elif [[ "$key" == "Exec" ]]; then
                parse_exec_path "$value"
            fi
        done <"$desk"
        # La ruta original se prefiere sobre la reconstruida desde Exec.
        [ -n "$source_path" ] && exec_path=$source_path
        # Separación NUL: las rutas pueden contener «|», espacios o saltos.
        printf '%s\0%s\0' "$x" "$exec_path" >>"$list_wall"
        if [ -f "$exec_path" ] || [[ $exec_path =~ ^https?:// ]]; then
            printf '%b   %s\t%b%s %b%s%b\n' "$BPurple" "$x" "$BCyan" \
                "${name:0:100}" "$BGreen" "${Lang[1]}" "$CReset"
        else
            printf '%b   %s\t%b%s %b%s%b\n' "$BPurple" "$x" "$BCyan" \
                "${name:0:100}" "$BRed" "${Lang[2]}" "$CReset"
        fi
        ((x++))
    done

    if ((x == 1)); then
        rm -f "$list_wall"
        echo -e "${BRed}No hay wallpapers añadidos aún.${CReset}\n"
    fi
}

finish() {
    keshiki_lock || return 1
    keshiki_stop
    local status=$?
    keshiki_unlock
    return "$status"
}

start() {
    if [ ! -f "$list_wall" ]; then
        echo -e "\n${BYellow}Primero ejecuta la opción '-l'$CReset\n"
        exit 1
    fi
    echo -e "Iniciando...\n"
    local index path target_cmd=""
    # Coincidencia exacta del índice, leyendo campos separados por NUL.
    while IFS= read -r -d '' index && IFS= read -r -d '' path; do
        if [[ $index == "$1" ]]; then
            target_cmd=$path
            break
        fi
    done <"$list_wall"
    if [ -n "$target_cmd" ]; then
        "${HERE}/keshiki-start" "$target_cmd"
    else
        echo -e "${BRed}Número de wallpaper no válido.${CReset}\n"
    fi
}

add() {
    echo -e "${BPurple}Añadiendo: ${OPTARG}$CReset"
    "${HERE}/keshiki-add" "${OPTARG}"
    echo -e "${BCyan}Listo.$CReset\n"
}

[ -z "${1:-}" ] || [[ $1 == - ]] && echo -e "${Lan[9]}\n${Lan[10]}"

while getopts ":hvrlfs:a:" arg; do
    case "$arg" in
        h)
            print_help
            exit 0
            ;;
        v)
            echo -e "\n\e[5;01m$BCyan $script$CReset Version 1.4\n"
            exit 0
            ;;
        r) restore ;;
        f) finish ;;
        l) list_wallpaper ;;
        s) start "${OPTARG}" ;;
        a) add "${OPTARG}" ;;
        \?)
            echo "Error: Opción desconocida -$OPTARG"
            print_help
            exit 1
            ;;
        :)
            echo "La opción '-$OPTARG' requiere un argumento."
            exit 1
            ;;
        *)
            print_help
            exit 1
            ;;
    esac
done
