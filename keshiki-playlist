HERE="$(dirname "$(readlink -f "${0}")")"
DIRCONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/keshiki/"
ICON=${ICON:-$HERE/keshiki.png}
playlist_file="${DIRCONFIG}playlist.txt"
items=()

for desk in "${DIRCONFIG}desktops/"*.desktop; do
    [ -f "$desk" ] || continue
    name=${desk##*/}
    name=${name%.desktop}
    icon=$(sed -n 's/^Icon=//p' "$desk")
    if [ -f "$playlist_file" ] && grep -qxF -- "$name" "$playlist_file"; then
        items+=(TRUE "$icon" "$name")
    else
        items+=(FALSE "$icon" "$name")
    fi
done
if ((${#items[@]} == 0)); then
    keshiki --window-icon="$ICON" --center --error --text="No tenés wallpapers agregados para crear una lista."
    exit 1
fi
if select=$(keshiki --window-icon="$ICON" --center --list --checklist --width=839 --height=498 \
    --text-align=center --title="Keshiki Playlist Manager" \
    --button="Cancelar!gtk-cancel":1 --button="Aceptar!gtk-ok":0 \
    --column="":CHK --column="Vista previa":IMG --column="Nombre":TXT \
    --search-column=3 --separator="|" "${items[@]}"); then
    tmp=$(mktemp "${DIRCONFIG}playlist.XXXXXXXX") || exit 1
    trap 'rm -f -- "$tmp"' EXIT
    printf '%s\n' "$select" | cut -d'|' -f3 >"$tmp" || exit 1
    mv -f -- "$tmp" "$playlist_file" || exit 1
fi
