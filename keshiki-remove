#!/bin/bash
# Realizado por: S.Konqi0139
#
# Eres libre de modificarlo a tu gusto, solo te pido
# nombrarme como autor del script
#
# La función restart y las variables Color/ICON las exporta el entorno
# gráfico de Keshiki (keshiki.bash); DIRCONFIG es fija por diseño.

BRed='\e[1;31m' BYellow='\e[1;33m' CReset="\e[m"
Color=${Color:-"color='#31E6F0'"}
remove_list=$(mktemp "${TMPDIR:-/tmp}/keshiki-remove.XXXXXXXX") || exit 1
trap 'rm -f -- "$remove_list"' EXIT
trap 'exit 1' INT TERM
DIRCONFIG="${DIRCONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/keshiki/}"
DIRCONFIG="${DIRCONFIG%/}/"
declare -a list_items
declare -A item_by_idx=()

if [[ $LANG = es* ]]; then Lan=("Todo"); else Lan=("ALL"); fi
cd "$DIRCONFIG" || exit

# El checklist se pasa a yad como array, nunca re-expandido sin comillas:
# los nombres pueden contener espacios.
list_items=(FALSE 0 gtk-select-all "${Lan[0]}")

idx=1
for desk in desktops/*.desktop; do
    [ -e "$desk" ] || continue
    item_name="${desk##*/}"
    item_icon=$(grep "^Icon=" "$desk" | cut -d'=' -f2)
    item_name="${item_name%.desktop}"
    [[ $item_name != . && $item_name != .. ]] || continue
    list_items+=(FALSE "$idx" "$item_icon" "$item_name")
    # Solo se elimina por índice resuelto aquí: el número que devuelve yad
    # nunca se usa como parte de una ruta directamente.
    item_by_idx["$idx"]=$item_name
    idx=$((idx + 1))
done

yad --window-icon="${ICON:-}" --center --list --checklist --width=839 --height=498 --text-align=center \
    --text="Seleccione los wallpapers que desea quitar" --title="Quitar Wallpapers" \
    --column="":CHK --column="#":NUM --column="Vista previa":IMG \
    --column="Nombre":TXT --search-column=4 \
    --button="<span $Color>Cancelar</span>!gtk-cancel:1" \
    --button="<span $Color>Quitar</span>!gtk-delete:0" "${list_items[@]}" |
    cut -f2 -d'|' >"$remove_list"

[ ! -s "$remove_list" ] && exit 0

while read -r opt; do
    [ -z "$opt" ] && continue
    echo -e "\n${BYellow}Quitando:${CReset}\n"

    if [ "$opt" = "0" ]; then
        rm -rf -- "${DIRCONFIG}resources" "${DIRCONFIG}desktops"
        restart
        break
    else
        if [[ ! $opt =~ ^[1-9][0-9]*$ ]] || [ -z "${item_by_idx[$opt]+present}" ]; then
            printf 'Selección inválida descartada: %s\n' "$opt" >&2
            continue
        fi
        item_name=${item_by_idx[$opt]}
        echo -e "${BRed}${item_name}${CReset}\n"
        rm -rf -- "${DIRCONFIG}resources/${item_name}" \
            "${DIRCONFIG}desktops/${item_name}.desktop"
    fi
done <"$remove_list"
